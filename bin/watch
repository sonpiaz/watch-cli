#!/usr/bin/env bash
# watch <url> [frame-count] [--cookies <file>] [--format text|json] [--pipe]
#             [--no-cache]
# One-shot orchestrator: download a video, extract evenly-spaced frames,
# transcribe the audio. Prints a single structured block easy for an AI
# agent to consume.
#
# Every successful run is archived (see lib/archive.sh and docs/archive.md),
# so watching the same source again reuses the stored transcript instead of
# paying for ASR twice. --no-cache forces a fresh run. The output block is
# byte-identical whether it came from cache or from the network — the cache
# is a cost optimization, not a different mode. Query the archive with
# `watch-archive ls|find|get`.
#
# Text format (default) — see docs/output-schema.md:
#   WATCH_OUTPUT_VERSION: 1
#   VIDEO: <path>
#   DURATION: <seconds>
#   FRAMES:
#     <path1>
#     <path2>
#     …
#   TRANSCRIPT:
#     <full text>
#   EXIT: <code>
#
# JSON format (--format json) — single line:
#   {"version":1,"video_path":"…","duration_sec":…,"frame_paths":[…],
#    "transcript":"…"|null,"exit_code":…}
#
# Pipe mode (--pipe): reads URLs from stdin (one per line), emits one
# compact JSON object per URL to stdout (JSONL). Implies --format json
# and suppresses text-format block markers. Errors per line keep
# version:1 so consumers can detect the schema, and processing
# continues to the next URL. Pipe mode is opt-in via --pipe; running
# `watch` with no args from a script context still exits 64 (usage).
#
# Exit codes: see docs/exit-codes.md.
#   0 success · 1 general · 2 missing-dep · 3 download fail
#   4 transcribe fail (partial: frames present, transcript=null)
#   64 usage error
#
# Default frame count = 8.

# Note: no `set -e`. We inspect downstream exit codes ourselves so partial
# success (frames OK, transcribe failed → exit 4) still emits a block.
set -uo pipefail

# Resolve symlinks so $ROOT_DIR points at the real install dir, not ~/.local.
# Done up-front because --version needs to source lib/version.sh before
# arg parsing decides what to print.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ $SELF != /* ]] && SELF="$SELF_DIR/$SELF"
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
ROOT_DIR="$(cd "$SELF_DIR/.." && pwd)"
# shellcheck source=../lib/version.sh
source "$ROOT_DIR/lib/version.sh"
# shellcheck source=../lib/health.sh
source "$ROOT_DIR/lib/health.sh"
# shellcheck source=../lib/archive.sh
source "$ROOT_DIR/lib/archive.sh"

URL=""
COUNT="8"
COOKIES_ARG=""
FORMAT="text"
PIPE=0
NO_CACHE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cookies)
      COOKIES_ARG="--cookies $2"
      shift 2
      ;;
    --cookies=*)
      COOKIES_ARG="--cookies ${1#*=}"
      shift
      ;;
    --format)
      FORMAT="${2:-}"
      shift 2
      ;;
    --format=*)
      FORMAT="${1#*=}"
      shift
      ;;
    --pipe)
      PIPE=1
      shift
      ;;
    --no-cache)
      NO_CACHE=1
      shift
      ;;
    -h|--help)
      sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -V|--version)
      echo "$WATCH_CLI_VERSION_STRING"
      exit 0
      ;;
    *)
      if [[ -z "$URL" ]]; then
        URL="$1"
      elif [[ "$COUNT" == "8" ]]; then
        COUNT="$1"
      fi
      shift
      ;;
  esac
done

# Pipe mode implies JSON output. A consumer reading JSONL doesn't want
# text-block markers interleaved between objects.
if [[ $PIPE -eq 1 ]]; then
  FORMAT="json"
fi

if [[ $PIPE -eq 0 && -z "$URL" ]]; then
  echo "usage: watch <url> [frame-count] [--cookies <file>] [--format text|json] [--pipe] [--no-cache] tag=usage-error" >&2
  exit 64
fi

if [[ "$FORMAT" != "text" && "$FORMAT" != "json" ]]; then
  echo "[watch] error: --format must be 'text' or 'json' (got '$FORMAT') tag=usage-error" >&2
  exit 64
fi

MISSING_DEP=""
check_dependencies() {
  local dep
  for dep in yt-dlp ffmpeg ffprobe jq curl python3; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      MISSING_DEP="$dep"
      echo "[watch] error: $dep not found on PATH tag=missing-dep:$dep" >&2
      return 2
    fi
  done
}

if [[ $PIPE -eq 0 ]]; then
  check_dependencies
  DEPENDENCY_RC=$?
  [[ $DEPENDENCY_RC -ne 0 ]] && exit "$DEPENDENCY_RC"
fi

# ── Per-URL pipeline ──────────────────────────────────────────────
# Runs the download → frames → transcribe sequence for one URL.
# Emits the documented block on stdout, returns the exit code.
#
# In pipe mode this is called once per stdin line; in single-URL mode
# it runs exactly once.
process_url() {
  local url="$1"
  local count="$2"
  local format="$3"
  local cookies_arg="$4"
  local pipe_mode="$5"

  # Pre-flight: upstream platform probe. Not a gate — just warns when
  # yt-dlp's extractor for this domain looks broken today, so a doomed
  # 30s download surfaces a hint up front.
  check_platform_for_url "$url" || true

  local video dur dur_int frames transcript
  local dl_rc ef_rc tr_rc=0
  local from_cache=0

  # ── Archive lookup ──
  # A record only counts when its transcript is non-empty (see
  # lib/archive.sh), so a previously failed transcribe never masks a retry.
  # Frames are archived alongside the record and therefore outlive /tmp; the
  # mp4 is not, so if it has been cleared we still re-download — VIDEO: must
  # name a file that exists — but the ASR call is skipped either way.
  if [[ $NO_CACHE -eq 0 ]] && watch_archive_has "$url"; then
    video="$(watch_archive_field "$url" video_path)"
    dur_int="$(watch_archive_field "$url" duration)"
    frames="$(watch_archive_field "$url" frame_paths)"
    transcript="$(watch_archive_field "$url" transcript)"

    # The stored frame count is whatever the run that filled this record
    # asked for. docs/output-schema.md promises the caller gets the count
    # they requested, so a mismatch means recutting — cheap, local ffmpeg —
    # while still skipping the ASR call, which is the part worth caching.
    local cached_frames rec_frames
    cached_frames="$(grep -c . <<< "$frames")"
    rec_frames="$(watch_archive_dir_for "$url")/frames"

    if [[ -z "$video" || ! -f "$video" ]]; then
      echo "[watch] cache hit, but the video is gone — re-downloading …" >&2
      # shellcheck disable=SC2086
      video="$("$SELF_DIR/dl-video" "$url" $cookies_arg)"
      dl_rc=$?
      if [[ $dl_rc -ne 0 ]]; then
        [[ "$pipe_mode" -eq 1 ]] && _emit_pipe_error "$url" "$dl_rc" "download-failed"
        return $dl_rc
      fi
    fi

    if [[ "$cached_frames" != "$count" ]]; then
      echo "[watch] cache hit; recutting $count frames (record has $cached_frames) …" >&2
      rm -rf "$rec_frames"
      mkdir -p "$rec_frames"
      frames="$("$SELF_DIR/extract-frames" "$video" "$count" "$rec_frames")"
      ef_rc=$?
      if [[ $ef_rc -ne 0 ]]; then
        echo "[watch] error: extract-frames failed (rc=$ef_rc)" >&2
        [[ "$pipe_mode" -eq 1 ]] && _emit_pipe_error "$url" 1 "extract-frames-failed"
        return 1
      fi
      watch_archive_set_frames "$url" "$rec_frames/frames.json" \
        || echo "[watch] warning: could not update archived frames" >&2
    else
      echo "[watch] cache hit — skipping download and transcription" >&2
    fi
    from_cache=1
  fi

  if [[ $from_cache -eq 0 ]]; then
    echo "[watch] downloading $url …" >&2
    # shellcheck disable=SC2086
    video="$("$SELF_DIR/dl-video" "$url" $cookies_arg)"
    dl_rc=$?
    if [[ $dl_rc -ne 0 ]]; then
      if [[ "$pipe_mode" -eq 1 ]]; then
        _emit_pipe_error "$url" "$dl_rc" "download-failed"
        return $dl_rc
      fi
      return $dl_rc
    fi
    echo "[watch] video: $video" >&2

    dur="$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$video" 2>/dev/null || echo 0)"
    dur_int="${dur%.*}"
    [[ -z "$dur_int" ]] && dur_int=0

    echo "[watch] extracting $count frames …" >&2
    # Cut frames straight into the archive record rather than /tmp, then copy.
    # One location means a cache hit emits the same paths a cold run did, and
    # the frames outlive /tmp being cleared. docs/output-schema.md classes the
    # frame directory as implementation detail, so moving it is contract-safe.
    local rec_frames
    rec_frames="$(watch_archive_dir_for "$url")/frames"
    mkdir -p "$rec_frames"
    frames="$("$SELF_DIR/extract-frames" "$video" "$count" "$rec_frames")"
    ef_rc=$?
    if [[ $ef_rc -ne 0 ]]; then
      echo "[watch] error: extract-frames failed (rc=$ef_rc)" >&2
      if [[ "$pipe_mode" -eq 1 ]]; then
        _emit_pipe_error "$url" 1 "extract-frames-failed"
      fi
      return 1
    fi

    echo "[watch] transcribing audio …" >&2
    local seg_file
    seg_file="$(mktemp)"
    transcript="$("$SELF_DIR/transcribe" "$video" --segments-out "$seg_file")"
    tr_rc=$?

    # Store only on success. An empty transcript is not an answer worth
    # remembering — the next run should get a real attempt, not this one.
    if [[ $tr_rc -eq 0 && -n "$transcript" ]]; then
      local info_json
      info_json="${video%.mp4}.info.json"
      [[ -f "$info_json" ]] || info_json=""
      watch_archive_put "$url" "$video" "$dur_int" \
        "$rec_frames/frames.json" "$seg_file" "$info_json" \
        || echo "[watch] warning: could not write archive record" >&2
    fi
    rm -f "$seg_file"
  fi

  local exit_code=0
  if [[ $tr_rc -ne 0 ]]; then
    exit_code=4
    transcript=""
  fi

  # ── Emit the contract block ──
  if [[ "$format" == "json" ]]; then
    local frame_json
    frame_json="$(printf '%s\n' "$frames" | jq -R . | jq -cs 'map(select(. != ""))')"

    if [[ $tr_rc -ne 0 ]]; then
      jq -cn \
        --argjson frames "$frame_json" \
        --arg video "$video" \
        --argjson dur "$dur_int" \
        --argjson rc "$exit_code" \
        '{version:1, video_path:$video, duration_sec:$dur, frame_paths:$frames, transcript:null, exit_code:$rc}'
    else
      jq -cn \
        --argjson frames "$frame_json" \
        --arg video "$video" \
        --argjson dur "$dur_int" \
        --arg transcript "$transcript" \
        --argjson rc "$exit_code" \
        '{version:1, video_path:$video, duration_sec:$dur, frame_paths:$frames, transcript:$transcript, exit_code:$rc}'
    fi
  else
    echo "WATCH_OUTPUT_VERSION: 1"
    echo "VIDEO: $video"
    echo "DURATION: $dur_int"
    echo "FRAMES:"
    while IFS= read -r f; do
      [[ -n "$f" ]] && echo "  $f"
    done <<< "$frames"
    echo "TRANSCRIPT:"
    if [[ $tr_rc -ne 0 ]]; then
      echo "  null"
    else
      echo "$transcript" | sed 's/^/  /'
    fi
    echo "EXIT: $exit_code"
  fi

  return $exit_code
}

# Emit a v1-shaped error object on stdout for pipe mode. Keeps
# `version: 1` so consumers can detect the schema and branch on
# exit_code. Other fields are null.
_emit_pipe_error() {
  local url="$1"
  local rc="$2"
  local tag="$3"
  jq -cn \
    --arg url "$url" \
    --argjson rc "$rc" \
    --arg tag "$tag" \
    '{version:1, url:$url, video_path:null, duration_sec:null, frame_paths:null, transcript:null, exit_code:$rc, error:$tag}'
}

# ── Pipe-mode loop ────────────────────────────────────────────────
if [[ $PIPE -eq 1 ]]; then
  # Track the worst-case exit code so the pipeline as a whole reports
  # a non-zero exit when any URL failed. Successful runs return 0.
  PIPE_WORST=0
  PIPE_DEPENDENCIES_CHECKED=0
  PIPE_DEPENDENCIES_RC=0
  while IFS= read -r LINE || [[ -n "$LINE" ]]; do
    # Skip blank lines / comments.
    LINE="${LINE%$'\r'}"
    [[ -z "$LINE" ]] && continue
    case "$LINE" in
      \#*) continue ;;
    esac
    # Basic URL sanity check: must contain `://` and at least one
    # alphanumeric char. Anything else surfaces as an error object
    # but the loop continues.
    if [[ ! "$LINE" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]]+$ ]]; then
      _emit_pipe_error "$LINE" 64 "invalid-url"
      (( PIPE_WORST < 64 )) && PIPE_WORST=64
      continue
    fi
    if [[ $PIPE_DEPENDENCIES_CHECKED -eq 0 ]]; then
      check_dependencies
      PIPE_DEPENDENCIES_RC=$?
      PIPE_DEPENDENCIES_CHECKED=1
    fi
    if [[ $PIPE_DEPENDENCIES_RC -ne 0 ]]; then
      _emit_pipe_error "$LINE" "$PIPE_DEPENDENCIES_RC" "missing-dep:$MISSING_DEP"
      (( PIPE_WORST < PIPE_DEPENDENCIES_RC )) && PIPE_WORST=$PIPE_DEPENDENCIES_RC
      continue
    fi
    process_url "$LINE" "$COUNT" "$FORMAT" "$COOKIES_ARG" 1
    RC=$?
    if [[ $RC -ne 0 ]]; then
      (( PIPE_WORST < RC )) && PIPE_WORST=$RC
    fi
  done
  exit "$PIPE_WORST"
fi

# ── Single-URL mode ───────────────────────────────────────────────
process_url "$URL" "$COUNT" "$FORMAT" "$COOKIES_ARG" 0
exit $?
